{
  "name": "pawl",
  "displayName": "Pawl",
  "description": "On-demand AI completion with a 0–5 help dial, triggered only by a go key.",
  "version": "0.0.1",
  "publisher": "pranavpage",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pranavpage/pawl-vscode.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pawl.go",
        "title": "Pawl: Go"
      },
      {
        "command": "pawl.setOpenRouterKey",
        "title": "Pawl: Set OpenRouter key"
      },
      {
        "command": "pawl.levelUp",
        "title": "Pawl: Level up"
      },
      {
        "command": "pawl.levelDown",
        "title": "Pawl: Level down"
      },
      {
        "command": "pawl.off",
        "title": "Pawl: Off (level 0, overrides pins)"
      },
      {
        "command": "pawl.pickLevel",
        "title": "Pawl: Choose level"
      }
    ],
    "keybindings": [
      {
        "command": "pawl.go",
        "key": "alt+enter",
        "when": "editorTextFocus && !findWidgetVisible && !notebookEditorFocused"
      },
      {
        "command": "pawl.levelUp",
        "key": "alt+="
      },
      {
        "command": "pawl.levelDown",
        "key": "alt+-"
      },
      {
        "command": "pawl.off",
        "key": "alt+0"
      },
      {
        "command": "pawl.reject",
        "key": "escape",
        "when": "editorTextFocus && inlineSuggestionVisible && pawl.suggestionVisible"
      },
      {
        "command": "pawl.acceptNextWord",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "editorTextFocus && !editorReadonly && inlineSuggestionVisible && pawl.suggestionVisible"
      }
    ],
    "configuration": {
      "title": "Pawl",
      "properties": {
        "pawl.models.level1": {
          "type": "string",
          "default": "deepseek/deepseek-v4.1-flash",
          "description": "OpenRouter model ID used at level 1 (Syntax). Any OpenRouter model works on any level.",
          "order": 0
        },
        "pawl.models.level2": {
          "type": "string",
          "default": "deepseek/deepseek-v4.1-flash",
          "description": "OpenRouter model ID used at level 2 (Sentence). Any OpenRouter model works on any level.",
          "order": 1
        },
        "pawl.models.level3": {
          "type": "string",
          "default": "z-ai/glm-5.3",
          "description": "OpenRouter model ID used at level 3 (Block). Any OpenRouter model works on any level.",
          "order": 2
        },
        "pawl.models.level4": {
          "type": "string",
          "default": "z-ai/glm-5.3",
          "description": "OpenRouter model ID used at level 4 (Skeleton). Any OpenRouter model works on any level.",
          "order": 3
        },
        "pawl.models.level5": {
          "type": "string",
          "default": "moonshotai/kimi-k3.1-pro",
          "description": "OpenRouter model ID used at level 5 (Plan step). Any OpenRouter model works on any level.",
          "order": 4
        },
        "pawl.timeout": {
          "type": "string",
          "enum": [
            "4s",
            "8s"
          ],
          "default": "8s",
          "markdownDescription": "How long one go-press may take, retries included, before Pawl gives up and shows `! timeout`. `4s` may time out at levels 3–5."
        },
        "pawl.log.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Append one line per go-press to `~/.pawl/sessions/YYYY-MM-DD.jsonl`."
        },
        "pawl.log.prompts": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Add the full prompt, which includes your code, to each session log line."
        },
        "pawl.keepTodoOnAccept": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep a `TODO:` comment once level 4 has filled it. Off: accepting the code removes the comment."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run compile && node ./out/test/smoke/runTest.js",
    "eval": "npm run compile && node ./out/eval/run.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.27.2"
  }
}
